{
  "manifest_version": 3,
  "name": "Work Health Reminder Pro",
  "version": "3.2.0",
  "description": "Nhắc nhở chăm sóc sức khỏe khi làm việc: đi bộ, uống nước, bài tập mắt, giãn cơ. Tự tắt khi bạn rời máy hoặc đang họp.",
  "author": "Work Health Team",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Work Health Reminder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "scripting",
    "idle"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://api.telegram.org/*",
    "http://localhost:9876/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "youtube-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "add_water": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Uống thêm 1 ly nước"
    },
    "toggle_focus": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Bật/tắt Focus Mode 30 phút"
    },
    "toggle_pomodoro": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Bật/tắt Pomodoro"
    },
    "toggle_pause": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Tạm dừng/tiếp tục nhắc nhở"
    }
  }
}
